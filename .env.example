# Cho‘ntakcha — muhit o‘zgaruvchilari (Vercel → Project → Settings → Environment Variables)
# Lokal ishlab chiqishda hech biri shart emas: baza .data/pglite ichida, rasmlar .data/uploads ichida saqlanadi.

# Postgres (Neon). Vercel → Storage → Neon ulaganda avtomatik qo‘shiladi.
DATABASE_URL=

# Rasmlar uchun Vercel Blob. Blob store ulaganda avtomatik qo‘shiladi.
BLOB_READ_WRITE_TOKEN=

# Sessiya imzosi uchun uzun tasodifiy satr (openssl rand -hex 32).
SESSION_SECRET=

# Telegram bot (@BotFather’dan). Faqat Vercel’da “Sensitive” sifatida saqlang.
TELEGRAM_BOT_TOKEN=

# Admin telefon raqamlari, vergul bilan: +998901234567,+998911234567
ADMIN_PHONES=

# Namuna ma’lumotlar: 1 — bo‘sh bazaga namunalar qo‘shiladi, 0 — qo‘shilmaydi.
SEED_SAMPLE=1

# Ixtiyoriy: sayt manzili (bo‘lmasa Vercel’dan avtomatik aniqlanadi).
APP_URL=

# Ixtiyoriy: Vercel Cron so‘rovlarini tekshirish uchun.
CRON_SECRET=
